{
  "name": "ipodracer",
  "productName": "iPodRacer",
  "version": "0.2.0",
  "description": "iPodRacer: a fully procedural 3D podracing game (Three.js)",
  "author": "tcsenpai <tcsenpai@users.noreply.github.com>",
  "homepage": "https://github.com/tcsenpai/iPodRacer",
  "repository": {
    "type": "git",
    "url": "https://github.com/tcsenpai/iPodRacer.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.tcsenpai.ipodracer",
    "productName": "iPodRacer",
    "artifactName": "iPodRacer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.racing-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "iPodRacer-${version}-win-portable.${ext}"
    },
    "linux": {
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "tcsenpai",
      "repo": "iPodRacer",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@types/three": "^0.186.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/news-cycle": "^5.3.0"
  }
}
